TRANSCRIPT_PROVIDER=local
TRANSCRIPT_HTTP_FALLBACK_ENABLED=false
TRANSCRIPT_API_URL=https://youtube-transcript-api-tau-one.vercel.app/transcript
TRANSCRIPT_TIMEOUT_MS=10000
# One OpenRouter connection is shared by every LLM role. Keep the key server-side.
LLM_PROVIDER=openrouter
LLM_API_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=300000
# Optional OpenRouter attribution headers.
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=CreatorPilot
# Optional Agent-specific overrides. Any blank value falls back to LLM_* above.
ANALYST_LLM_PROVIDER=
ANALYST_LLM_API_BASE_URL=
ANALYST_LLM_API_KEY=
ANALYST_LLM_MODEL=
ANALYST_LLM_TIMEOUT_MS=300000
# Deep analysis only: each role can use a different model or provider. Blank
# values reuse ANALYST_LLM_* (then shared LLM_*), so Standard remains one call.
ANALYST_A_LLM_MODEL=
ANALYST_B_LLM_MODEL=
ANALYST_JUDGE_LLM_MODEL=
# Research automatically selects OpenRouter's openrouter:web_search server tool
# when the shared OpenRouter provider or URL is used.
RESEARCH_LLM_PROVIDER=
RESEARCH_LLM_API_BASE_URL=
RESEARCH_LLM_API_KEY=
RESEARCH_LLM_MODEL=
RESEARCH_LLM_TIMEOUT_MS=300000
# Deep research roles should be valid OpenRouter model slugs.
RESEARCH_A_LLM_MODEL=
RESEARCH_B_LLM_MODEL=
RESEARCH_JUDGE_LLM_MODEL=
SCRIPTWRITER_LLM_PROVIDER=
SCRIPTWRITER_LLM_API_BASE_URL=
SCRIPTWRITER_LLM_API_KEY=
SCRIPTWRITER_LLM_MODEL=
# Claim-led full-duration drafts may require a repair pass; allow up to five minutes per model call.
SCRIPTWRITER_LLM_TIMEOUT_MS=300000
# Deep writing roles use the OpenAI-compatible Chat Completions contract.
SCRIPTWRITER_A_LLM_MODEL=
SCRIPTWRITER_B_LLM_MODEL=
SCRIPTWRITER_JUDGE_LLM_MODEL=
REVIEWER_LLM_PROVIDER=
REVIEWER_LLM_API_BASE_URL=
REVIEWER_LLM_API_KEY=
REVIEWER_LLM_MODEL=
REVIEWER_LLM_TIMEOUT_MS=
STORYBOARD_LLM_PROVIDER=
STORYBOARD_LLM_API_BASE_URL=
STORYBOARD_LLM_API_KEY=
STORYBOARD_LLM_MODEL=
STORYBOARD_LLM_TIMEOUT_MS=
# Video Producer is intentionally separate from every LLM setting above.
RENDER_PROVIDER=http
RENDER_API_BASE_URL=
RENDER_API_KEY=
RENDER_TIMEOUT_MS=30000
# Shotstack alternative (use the stage endpoint and stage key first).
SHOTSTACK_API_URL=https://api.shotstack.io/edit/stage/render
SHOTSTACK_API_KEY=
SHOTSTACK_TIMEOUT_MS=30000
PORT=8787
FRONTEND_ORIGIN=http://127.0.0.1:4173
